# WebCraft Environment Variables

# Server Port (development)
# Default: 5173 (Vite dev server)
VITE_PORT=5173

# Server Port (production)
# Default: 3000
PORT=3000

# Node Environment
# Options: development, production
NODE_ENV=development

# Debug Mode (logs WebSocket messages)
# Options: true, false
DEBUG=false

# Minecraft Server Defaults (prefilled in Direct Connect)
VITE_DEFAULT_SERVER_HOST=localhost
VITE_DEFAULT_SERVER_PORT=25565

# Custom Username Prefix
# Will be seen as "WebPlayer_1234" etc. on servers
VITE_USERNAME_PREFIX=WebPlayer
